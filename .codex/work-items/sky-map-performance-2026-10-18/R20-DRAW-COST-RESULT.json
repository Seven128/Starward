  "decision": {
    "nextImplementation": "One current exact-input stellar drawing preparation at the existing Scene/Canvas lifetime; replay current transitions, picking/names and GPU submission every paint",
    "status": "READY_FOR_LOCAL_IMPLEMENTATION_AND_INDEPENDENT_REVIEW_NOT_PRODUCT_ADOPTION",
    "reason": "The target actual traversal is material in both effect and continuation paints; current transform already caches directions/transmission but repeated projection/appearance/raw-star assembly is outside that reuse. A bounded local equal-output comparison supports removing that repeated preparation, without another profile of the same level.",
    "benefitScope": "Same exact time/view/appearance/catalogue inputs including resource/name/image continuation; no reuse across new precise time or real view changes. It may free work between inputs; does not guarantee faster first paint or all intents accepted.",
    "alternatives": [
      {
        "name": "Per-frame or per-tile added projection arrays/global WeakMap history",
        "decision": "Do not add; route all extra retention through one explicitly cleared current Canvas owner."
      },
      {
        "name": "Transition snapshot pooling/in-place mutation",
        "decision": "Do not adopt; changes accepted/rejected-state isolation, no attributed need versus simpler pure preparation reuse."
      },
      {
        "name": "Typed-array pooling or skipping GL submissions",
        "decision": "Do not adopt from this sample; submit has extensive below-resolution calls and remains live every frame."
      },
      {
        "name": "Arbitrary throttle/debounce/time quantization/reduced star count/gen24 scene memo",
        "decision": "Not authorized by these results; retain original work and scheduling."
      }
    ]
  },
