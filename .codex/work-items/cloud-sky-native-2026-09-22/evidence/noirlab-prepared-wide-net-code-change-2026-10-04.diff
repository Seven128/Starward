+    def test_empty_spatial_note_accepts_known_wire_form_without_changing_geometry_or_other_bytes(self):
+        raw = packet(empty_notes=True, empty_spatial_notes=True)
+        observation, _, _, _ = self.load(raw)
+        self.assertEqual(observation.raw_xmp, raw)
+        self.assertTrue(observation.removed_empty_spectral_notes)
+        self.assertTrue(observation.removed_empty_spatial_notes)
+        self.assertIsNone(observation.geometry.spatial_notes)
+        self.assertIsNone(observation.spectral_notes)
+        first = raw.index(b"<avm:Spectral.Notes>")
+        last = raw.index(b"</avm:Spectral.Notes>") + len(b"</avm:Spectral.Notes>")
+        expected = raw[:first] + raw[last:]
+        first = expected.index(b"<avm:Spatial.Notes>")
+        last = expected.index(b"</avm:Spatial.Notes>") + len(b"</avm:Spatial.Notes>")
+        expected = expected[:first] + expected[last:]
+        self.assertEqual(observation.parser_xmp, expected)
+        populated, _, _, _ = self.load()
+        self.assertFalse(populated.removed_empty_spatial_notes)
+        self.assertEqual(observation.geometry.crpix, populated.geometry.crpix)
+        self.assertEqual(observation.geometry.cdelt, populated.geometry.cdelt)
+        self.assertEqual(observation.geometry.reference_value, populated.geometry.reference_value)
+        self.assertEqual(observation.rgb_bytes, populated.rgb_bytes)
+        with self.assertRaisesRegex(RuntimeError, "empty_spatial_notes_unsupported"):
+            self.load(packet(empty_spatial_notes=True).replace(b'x-default', b'other-language'))
+        duplicated = packet(empty_spatial_notes=True).replace(
+            b'</avm:Spatial.Notes>', b'</avm:Spatial.Notes><avm:Spatial.Notes>Second</avm:Spatial.Notes>')
+        with self.assertRaisesRegex(RuntimeError, "spatial_notes_ambiguous"):
+            self.load(duplicated)
