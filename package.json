{
  "name": "starward",
  "version": "1.0.0",
  "description": "Starward mobile stargazing decision product and design system.",
  "scripts": {
    "context:sync": "node tools/run-node.cjs --bin project-tiny-context-harness ty-context sync",
    "context:validate": "node tools/run-node.cjs --bin project-tiny-context-harness ty-context validate-context",
    "context:doctor": "node tools/run-node.cjs --bin project-tiny-context-harness ty-context doctor",
    "design:lint": "npx --yes --package @google/design.md designmd lint DESIGN.md",
    "design:system:verify": "node tools/run-node.cjs tools/verify-design-system.mjs",
    "design:targets:verify": "node tools/run-node.cjs tools/verify-design-targets.mjs",
    "check:product:consumers": "npm run typecheck --workspace @starward/mobile && npm run typecheck --workspace @starward/api && npm run typecheck --workspace @starward/admin-web",
    "dev:miniapp": "node tools/run-node.cjs tools/miniapp/start-development-session.mjs",
    "miniapp:observe": "node tools/run-node.cjs tools/miniapp/development-observer.mjs",
    "miniapp:devtools:sync": "node tools/run-node.cjs tools/miniapp/wechatide-skill-sync.mjs",
    "miniapp:device": "node tools/run-node.cjs tools/miniapp/device-test.mjs",
    "miniapp:device:feedback": "node tools/run-node.cjs tools/miniapp/device-feedback.mjs",
    "dev:miniapp:api": "npm run dev --workspace @starward/miniapp-api",
    "dev:miniapp:worker": "npm run dev:worker --workspace @starward/miniapp-api",
    "dev:miniapp:weapp": "npm run dev:weapp --workspace @starward/wechat-miniapp",
    "miniapp:admin": "node tools/run-node.cjs tools/miniapp/admin-operations.mjs",
    "miniapp:icons": "node tools/run-node.cjs tools/miniapp/generate-mode-icons.mjs",
    "miniapp:design-tokens": "node tools/run-node.cjs tools/miniapp/generate-design-tokens.mjs",
    "check:miniapp:design-tokens": "node tools/run-node.cjs tools/miniapp/generate-design-tokens.mjs --check",
    "check:miniapp:icons": "node tools/run-node.cjs tools/miniapp/generate-mode-icons.mjs --check",
    "miniapp:semantic-assets": "node tools/run-node.cjs tools/miniapp/generate-semantic-assets.mjs",
    "check:miniapp:semantic-assets": "node tools/run-node.cjs tools/miniapp/generate-semantic-assets.mjs --check",
    "check:miniapp:sdk": "node tools/run-node.cjs tools/miniapp/generate-miniapp-sdk.mjs --check",
    "miniapp:conformance-review": "node tools/run-node.cjs tools/miniapp/conformance-review.mjs",
    "prepare:miniapp:final-candidate": "npm run check:miniapp:fast && npm run check:miniapp:production",
    "miniapp:infra:up": "docker compose -f infra/miniapp/docker-compose.yml up -d --wait",
    "miniapp:infra:down": "docker compose -f infra/miniapp/docker-compose.yml down",
    "miniapp:backup": "node tools/run-node.cjs tools/miniapp/backup-restore.mjs backup",
    "miniapp:restore": "node tools/run-node.cjs tools/miniapp/backup-restore.mjs restore",
    "miniapp:bundle": "node tools/run-node.cjs tools/miniapp/build-release-bundle.mjs",
    "miniapp:platform": "node tools/run-node.cjs tools/miniapp/upload-release-bundle.mjs",
    "miniapp:app-id": "node tools/run-node.cjs tools/miniapp/wechat-app-id-migration.mjs",
    "check:miniapp:app-id": "node tools/run-node.cjs tools/miniapp/wechat-app-id-migration.mjs check",
    "check:miniapp:release-code": "npm run check:miniapp:sdk && npm run typecheck --workspace @starward/miniapp-contracts && npm run typecheck --workspace @starward/miniapp-api && npm run typecheck --workspace @starward/wechat-miniapp",
    "build:miniapp:release": "npm run build:release --workspace @starward/coordinate-system && npm run build:release --workspace @starward/miniapp-contracts && npm run build:release --workspace @starward/astronomy-core && npm run build:release --workspace @starward/miniapp-api",
    "deployment:prepare": "node tools/run-node.cjs tools/deployment/prepare-release-candidate.mjs",
    "deployment:validate-env": "node tools/run-node.cjs tools/deployment/validate-release-environment.mjs",
    "deployment:backup": "node tools/run-node.cjs tools/deployment/verified-backup.mjs",
    "deployment:recover": "node tools/run-node.cjs tools/deployment/recover-database.mjs",
    "deployment:release": "node tools/run-node.cjs tools/deployment/release.mjs",
    "deployment:promote": "node tools/run-node.cjs tools/deployment/promote-release-candidate.mjs",
    "deployment:preview": "node tools/run-node.cjs tools/deployment/operator-preview-cli.mjs",
    "deployment:create-request": "node tools/run-node.cjs tools/deployment/promotion-request.mjs create",
    "deployment:run-request": "node tools/run-node.cjs tools/deployment/promotion-request.mjs run",
    "check:miniapp:fast": "npm run check:miniapp:app-id && npm run check:miniapp:sdk && npm run typecheck --workspace @starward/miniapp-contracts && npm run typecheck --workspace @starward/miniapp-api && npm run typecheck --workspace @starward/wechat-miniapp && npm run design:system:verify && npm run check:miniapp:icons && npm run check:miniapp:semantic-assets",
    "context:upgrade": "node tools/run-node.cjs --bin project-tiny-context-harness ty-context upgrade",
    "check:miniapp:production": "node tools/run-node.cjs tools/miniapp/inspect-production.mjs",
    "check:miniapp:media": "node tools/run-node.cjs tools/miniapp/verify-media-assets.mjs",
    "node": "node tools/run-node.cjs",
    "assets:verify": "node tools/run-node.cjs tools/resources/assets.mjs verify",
    "assets:prepare": "node tools/run-node.cjs tools/resources/assets.mjs prepare",
    "assets:audit": "node tools/run-node.cjs tools/resources/assets.mjs audit",
    "assets:rules": "node tools/run-node.cjs tools/resources/assets.mjs rules",
    "prebuild:miniapp:release": "npm run assets:verify",
    "precheck:miniapp:release-code": "npm run assets:verify",
    "predev:miniapp": "npm run assets:verify",
    "predev:miniapp:api": "npm run assets:verify",
    "backend:data:status": "node tools/run-node.cjs --import tsx tools/resources/backend-data.mjs status",
    "backend:data:prepare": "node tools/run-node.cjs --import tsx tools/resources/backend-data.mjs prepare",
    "backend:data:verify": "node tools/run-node.cjs --import tsx tools/resources/backend-data.mjs verify",
    "backend:data:import": "node tools/run-node.cjs --import tsx tools/resources/backend-data.mjs import",
    "backend:data:env": "node tools/run-node.cjs --import tsx tools/resources/backend-data.mjs env",
    "backend:data:check-db": "node tools/run-node.cjs --import tsx tools/resources/backend-data.mjs check-db",
    "dev:miniapp:published": "node tools/run-node.cjs --import tsx tools/resources/backend-data.mjs start"
  },
  "keywords": [
    "stargazing",
    "design-system",
    "tiny-context"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*",
    "tools/context-check"
  ],
  "devDependencies": {
    "miniprogram-automator": "^0.12.1",
    "pngjs": "^7.0.0",
    "project-tiny-context-harness": "0.12.1",
    "zod": "4.4.3"
  },
  "tyContext": {
    "harnessFolderName": ".codex"
  },
  "dependencies": {
    "expo": "~57.0.7",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "5.12.7"
    }
  }
}
