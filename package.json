{
  "name": "starward",
  "version": "1.0.0",
  "description": "Starward mobile stargazing decision product and design system.",
  "scripts": {
    "postinstall": "node tools/miniapp/apply-ty-context-harness-compatibility.mjs",
    "context:sync": "ty-context sync",
    "context:validate": "ty-context validate-context",
    "context:doctor": "ty-context doctor",
    "design:lint": "npx --yes --package @google/design.md designmd lint DESIGN.md",
    "design:system:verify": "node tools/verify-design-system.mjs",
    "design:targets:verify": "node tools/verify-design-targets.mjs",
    "dev:acceptance:mobile": "node tests/acceptance/start-mobile-web.mjs --port 4173 --watch-api",
    "test:mobile:fast": "npm run typecheck --workspace @starward/mobile && npm run test --workspace @starward/mobile",
    "test:verification:fast": "node --test tests/acceptance/mobile-web-session.test.mjs tests/acceptance/ui/mobile-design-diagnostic-support.test.mjs tools/long-task/native-verification-session.test.mjs tools/long-task/run-native-design-diagnostic.test.mjs tools/long-task/verify-native-target.test.mjs",
    "test:acceptance:mobile": "node tests/acceptance/run-mobile-web-check.mjs --isolated",
    "test:acceptance:mobile:warm": "node tests/acceptance/run-mobile-web-check.mjs",
    "dev:inspect:mobile:web": "node tests/acceptance/run-mobile-web-diagnostic.mjs",
    "dev:inspect:mobile:native": "node tools/long-task/run-native-design-diagnostic.mjs",
    "dev:miniapp": "node tools/miniapp/start-development-session.mjs",
    "dev:miniapp:api": "npm run dev --workspace @starward/miniapp-api",
    "dev:miniapp:worker": "npm run dev:worker --workspace @starward/miniapp-api",
    "dev:miniapp:weapp": "npm run dev:weapp --workspace @starward/wechat-miniapp",
    "miniapp:admin": "node tools/miniapp/admin-operations.mjs",
    "miniapp:icons": "node tools/miniapp/generate-mode-icons.mjs",
    "check:miniapp:icons": "node tools/miniapp/generate-mode-icons.mjs --check",
    "miniapp:semantic-assets": "node tools/miniapp/generate-semantic-assets.mjs",
    "check:miniapp:semantic-assets": "node tools/miniapp/generate-semantic-assets.mjs --check",
    "check:miniapp:sdk": "node tools/miniapp/generate-miniapp-sdk.mjs --check",
    "test:miniapp:design-bindings": "node tools/miniapp/verify-selected-design-bindings.mjs",
    "test:miniapp:design": "npm run check:miniapp:semantic-assets && npm run test:miniapp:design-bindings",
    "test:miniapp:workflow": "node --test tools/miniapp/workflow-conformance.test.mjs",
    "check:miniapp:harness-compatibility": "node tools/miniapp/apply-ty-context-harness-compatibility.mjs --check",
    "test:miniapp:infrastructure": "node tools/miniapp/run-infrastructure-check.mjs",
    "test:miniapp:native": "node tools/miniapp/run-wechat-devtools-session.mjs",
    "prepare:miniapp:final-candidate": ".\\tools\\miniapp\\verify-miniapp-target.exe --collect current --spec tools/miniapp/verification-spec-v2-1-1.json",
    "miniapp:infra:up": "docker compose -f infra/miniapp/docker-compose.yml up -d --wait",
    "miniapp:infra:down": "docker compose -f infra/miniapp/docker-compose.yml down",
    "miniapp:backup": "node tools/miniapp/backup-restore.mjs backup",
    "miniapp:restore": "node tools/miniapp/backup-restore.mjs restore",
    "miniapp:bundle": "node tools/miniapp/build-release-bundle.mjs",
    "miniapp:platform": "node tools/miniapp/upload-release-bundle.mjs",
    "test:miniapp:release": "node --test tools/miniapp/build-release-bundle.test.mjs",
    "test:miniapp:platform": "node --test tools/miniapp/upload-release-bundle.test.mjs",
    "check:miniapp:release-code": "npm run check:miniapp:sdk && npm run typecheck --workspace @starward/miniapp-contracts && npm run typecheck --workspace @starward/miniapp-api && npm run typecheck --workspace @starward/wechat-miniapp && npm run test --workspace @starward/miniapp-contracts && npm run test --workspace @starward/miniapp-api && npm run test --workspace @starward/wechat-miniapp",
    "build:miniapp:release": "npm run build:release --workspace @starward/coordinate-system && npm run build:release --workspace @starward/miniapp-contracts && npm run build:release --workspace @starward/miniapp-api",
    "deployment:prepare": "node tools/deployment/prepare-release-candidate.mjs",
    "deployment:validate-env": "node tools/deployment/validate-release-environment.mjs",
    "deployment:backup": "node tools/deployment/verified-backup.mjs",
    "deployment:recover": "node tools/deployment/recover-database.mjs",
    "deployment:release": "node tools/deployment/release.mjs",
    "deployment:promote": "node tools/deployment/promote-release-candidate.mjs",
    "deployment:create-request": "node tools/deployment/promotion-request.mjs create",
    "deployment:run-request": "node tools/deployment/promotion-request.mjs run",
    "test:deployment": "node --test tools/deployment/*.test.mjs",
    "check:miniapp:fast": "npm run check:miniapp:harness-compatibility && npm run check:miniapp:sdk && npm run typecheck --workspace @starward/miniapp-contracts && npm run typecheck --workspace @starward/miniapp-api && npm run typecheck --workspace @starward/wechat-miniapp && npm run test --workspace @starward/miniapp-contracts && npm run test --workspace @starward/miniapp-api && npm run test --workspace @starward/wechat-miniapp && npm run design:system:verify && npm run test:miniapp:workflow && npm run check:miniapp:icons && npm run check:miniapp:semantic-assets && npm run test:miniapp:design-bindings",
    "test:miniapp:current": "npm run check:miniapp:fast && npm run test:miniapp:infrastructure && npm run test:miniapp:native",
    "test": "npm run context:validate"
  },
  "keywords": [
    "stargazing",
    "design-system",
    "tiny-context"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "devDependencies": {
    "miniprogram-automator": "^0.12.1",
    "pngjs": "^7.0.0",
    "project-tiny-context-harness": "^0.8.17",
    "zod": "4.4.3"
  },
  "tyContext": {
    "harnessFolderName": ".codex"
  },
  "dependencies": {
    "expo": "~57.0.7",
    "react": "19.2.3",
    "react-native": "0.86.0"
  }
}
