{
  "name": "@starward/miniapp-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./test-fixtures": {
      "production": "./dist/catalog.js",
      "default": "./src/catalog.ts"
    }
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@starward/coordinate-system": "*"
  },
  "scripts": {
    "build:release": "node ../../tools/run-node.cjs ./node_modules/typescript/lib/tsc.js -p tsconfig.build.json",
    "generate:sdk": "node ../../tools/run-node.cjs ../../tools/miniapp/generate-miniapp-sdk.mjs",
    "check:sdk": "node ../../tools/run-node.cjs ../../tools/miniapp/generate-miniapp-sdk.mjs --check",
    "typecheck": "node ../../tools/run-node.cjs ./node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.json",
    "test": "node ../../tools/run-node.cjs --import tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
