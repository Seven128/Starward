          "states": [
            "unselected",
            "selected",
            "pressed",
            "disabled"
          ],
          "data": "one shared filter truth",
          "behavior": "Quick conditions commit immediately and the first selection may open Finder peek."
        },
        {
          "key": "family.map-analysis-bar-layer",
          "owner": "apps/wechat-miniapp/src/components/source-lift-focus-layer.tsx",
          "states": [
            "none",
            "light",
            "total-cloud",
            "tonight-condition",
            "partial",
            "stale",
            "error"
