          "owner": "apps/admin-web/src/app/page.tsx",
          "states": [
            "active",
            "suspended",
            "unpublished",
            "replaced",
            "retired",
            "failed"
          ],
          "data": "formal spot publication lifecycle",
          "behavior": "Every transition requires reason, actor, result and readback."
