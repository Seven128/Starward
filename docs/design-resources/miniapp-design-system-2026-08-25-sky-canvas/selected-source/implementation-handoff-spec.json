          "data": "current route tree",
          "behavior": "Only Map and My are primary destinations."
        },
        {
          "key": "family.my-plan-settings",
          "owner": "apps/wechat-miniapp/src/features/my/my-library-page.tsx",
          "states": [
            "loading",
            "ready",
            "empty",
            "partial",
            "error"
          ],
          "data": "identity-scoped plans/settings/account summary",
          "behavior": "My is a route hub and Settings is the sole observation-mode entry."
