{
	admin off
	auto_https disable_redirects
	log {
		output stdout
		format json
	}
}

https://{$STARWARD_API_DOMAIN} {
	tls internal
	encode zstd gzip

	@operator header X-Starward-Operator-Preview {$STARWARD_OPERATOR_PREVIEW_TOKEN}
	handle @operator {
		header {
			-Server
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		}

		reverse_proxy api:8787 {
			header_up -X-Starward-Operator-Preview
			health_uri /health/ready
			health_interval 15s
			health_timeout 3s
			lb_try_duration 5s
		}
	}

	respond 404

	log {
		output stdout
		format filter {
			request>headers>X-Starward-Operator-Preview delete
			wrap json
		}
	}
}
