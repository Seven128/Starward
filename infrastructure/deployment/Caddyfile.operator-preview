{
	admin off
	auto_https disable_redirects
	default_sni {$STARWARD_API_DOMAIN}
	skip_install_trust
	servers {
		protocols h1 h2
	}
	log {
		output stdout
		format filter {
			request delete
			resp_headers delete
			wrap json
		}
	}
}

https://{$STARWARD_API_DOMAIN} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
			disable_http_challenge
			timeout 120s
		}
	}
	encode zstd gzip

	@operator header X-Starward-Operator-Preview {$STARWARD_OPERATOR_PREVIEW_TOKEN}
	handle @operator {
		header {
			-Server
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		}

		reverse_proxy api:8787 {
			header_up -X-Starward-Operator-Preview
			health_uri /health/ready
			health_interval 15s
			health_timeout 3s
			lb_try_duration 5s
		}
	}

	respond 404

	log {
		output stdout
		format filter {
			request delete
			resp_headers delete
			wrap json
		}
	}
}
