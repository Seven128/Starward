[Unit]
Description=Starward personal-trial backup maintenance
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=starward-deploy
Group=starward-deploy
UMask=0077
ExecStart=/usr/local/bin/node /var/lib/starward/staging/operations/backup-maintenance-cli.mjs --pointer /var/lib/starward/staging/receipts/operator-preview-current.json
TimeoutStartSec=35min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=starward-backup-maintenance
