NODE_ENV=production
MINIAPP_API_HOST=0.0.0.0
MINIAPP_API_PORT=8787
MINIAPP_CORS_ORIGINS=https://api-staging.example.com
MINIAPP_TRUST_PROXY_CIDRS=172.30.10.2/32
MINIAPP_RATE_LIMIT_MAX=120
MINIAPP_RATE_LIMIT_WINDOW_MS=60000
MINIAPP_RELEASE_PROFILE=TRIAL
MINIAPP_STORAGE_MODE=POSTGRES
MINIAPP_AUTH_MODE=WECHAT
MINIAPP_MEDIA_STORAGE_MODE=DISABLED
MINIAPP_AUTO_MIGRATE=0
MINIAPP_ACCEPTANCE_MODE=0
MINIAPP_DEVELOPMENT_FIXTURE_MODE=0
DATABASE_URL=secret-ref:staging-database-url
REDIS_URL=secret-ref:staging-redis-url
MINIAPP_CACHE_PREFIX=starward:staging:
MINIAPP_QUEUE_NAME=starward-staging-outbox
WECHAT_MINIAPP_APP_ID=secret-ref:staging-wechat-app-id
WECHAT_MINIAPP_APP_SECRET=secret-ref:staging-wechat-app-secret
MINIAPP_SESSION_SECRET=secret-ref:staging-session-secret
MINIAPP_ADMIN_TOKEN=secret-ref:staging-admin-token
MINIAPP_WEATHER_PROVIDER=QWEATHER
MINIAPP_OPEN_METEO_EVIDENCE_MODE=OPEN_METEO_NONCOMMERCIAL
QWEATHER_API_HOST=secret-ref:staging-qweather-api-host
QWEATHER_CREDENTIAL_ID=secret-ref:staging-qweather-credential-id
QWEATHER_PROJECT_ID=secret-ref:staging-qweather-project-id
QWEATHER_PRIVATE_KEY_PEM=secret-ref:staging-qweather-private-key
MINIAPP_ROUTE_PROVIDER=DISABLED
MINIAPP_PLACE_SEARCH_PROVIDER=DISABLED
