# Copy outside the repository as the stable, non-secret base descriptor and
# resolve every placeholder. Do not add per-release candidate identity here;
# deployment:prepare derives it into a separate deploy.env.
STARWARD_ENVIRONMENT=staging
COMPOSE_PROJECT_NAME=starward-staging
STARWARD_IMAGE_REPOSITORY=registry.example/starward/miniapp-api
STARWARD_API_DOMAIN=api-staging.example.com
CADDY_EMAIL=operator@example.com
STARWARD_API_ENV_FILE=/etc/starward/staging/api.env
STARWARD_WORKER_ENV_FILE=/etc/starward/staging/worker.env
STARWARD_MIGRATE_ENV_FILE=/etc/starward/staging/migrate.env
STARWARD_POSTGRES_ENV_FILE=/etc/starward/staging/postgres.env
STARWARD_REDIS_ENV_FILE=/etc/starward/staging/redis.env
STARWARD_BACKUP_DIRECTORY=/var/lib/starward/staging/backups
STARWARD_BACKUP_ENCRYPTION_KEY_FILE=/etc/starward/staging/backup.key
# The initial in-memory encrypted backup owner fails closed above this size.
STARWARD_BACKUP_MAX_BYTES=268435456
STARWARD_RECEIPT_DIRECTORY=/var/lib/starward/staging/receipts
